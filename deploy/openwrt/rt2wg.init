#!/bin/sh /etc/rc.common
# rt2wg on OpenWrt: one procd instance per WireGuard interface listed in
# /etc/config/rt2wg. Peers come from the interface's wireguard_<iface>
# sections in /etc/config/network, converted to a wg-style file for rt2wg.
#
# The package keeps this script and its config across sysupgrade, but not
# the binary: when it is missing, start reinstalls the package from the url
# in /etc/config/rt2wg, and "upgrade" does so on demand.

START=95
USE_PROCD=1

EXTRA_COMMANDS="upgrade"
EXTRA_HELP="	upgrade	Download and install the package from the configured url"

PROG=/usr/bin/rt2wg
RUNDIR=/var/run/rt2wg

# install_package downloads the package from the configured url and installs
# it; apk's post-install script then enables and starts the service.
install_package() {
	local url tmp=/tmp/rt2wg.apk
	url=$(uci_get rt2wg package url)
	if [ -z "$url" ]; then
		echo "rt2wg: no package url set in /etc/config/rt2wg" >&2
		return 1
	fi
	uclient-fetch -q -O "$tmp" "$url" &&
		apk add --allow-untrusted --repositories-file /dev/null "$tmp"
	local ret=$?
	rm -f "$tmp"
	return $ret
}

# reinstall retries in the background, since at boot the network may not be
# up yet and apk must not run under this script's procd transaction.
reinstall() {
	(
		for i in 1 2 3; do
			install_package 2>&1 | logger -t rt2wg && [ -x "$PROG" ] && exit 0
			sleep 15
		done
		logger -t rt2wg "reinstall failed"
	) </dev/null >/dev/null 2>&1 &
}

upgrade() {
	install_package
}

collect_instance() {
	local enabled
	config_get_bool enabled "$1" enabled 1
	[ "$enabled" -eq 1 ] && append INSTANCES "$1"
}

# load_instances sets INSTANCES to the enabled rt2wg sections. It replaces
# the loaded config, so read their options with uci_get afterwards.
load_instances() {
	INSTANCES=
	config_load rt2wg
	config_foreach collect_instance instance
}

# write_peer prints one [Peer] for a wireguard_<iface> section. Disabled
# peers are skipped, as netifd does not put them on the device.
write_peer() {
	local disabled key ips
	config_get_bool disabled "$1" disabled 0
	[ "$disabled" -eq 1 ] && return 0
	config_get key "$1" public_key
	config_get ips "$1" allowed_ips
	printf '[Peer]\nPublicKey = %s\nAllowedIPs = %s\n\n' \
		"$key" "$(echo $ips | tr ' ' ',')"
}

# write_conf generates the peer file for $1 from the loaded network config.
# It is replaced atomically, since a running instance may reread it on HUP.
write_conf() {
	local out="$RUNDIR/$1.conf"
	mkdir -p "$RUNDIR"
	config_foreach write_peer "wireguard_$1" >"$out.tmp"
	mv "$out.tmp" "$out"
}

start_instance() {
	local iface tables log_level env
	iface=$(uci_get rt2wg "$1" interface "$1")
	tables=$(uci_get rt2wg "$1" tables)
	log_level=$(uci_get rt2wg "$1" log_level)

	write_conf "$iface"

	env="WG_INTERFACE=$iface WG_CONF_PATH=$RUNDIR/$iface.conf"
	[ -n "$tables" ] && append env "WG_ROUTE_TABLES=$(echo $tables | tr ' ' ',')"
	[ -n "$log_level" ] && append env "LOG_LEVEL=$log_level"

	procd_open_instance "$iface"
	procd_set_param command "$PROG"
	procd_set_param env $env
	# Retry forever: rt2wg exits if the WireGuard device does not exist yet.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local s
	if [ ! -x "$PROG" ]; then
		reinstall
		return 0
	fi
	load_instances
	config_load network
	for s in $INSTANCES; do
		start_instance "$s"
	done
}

# Regenerating the peer files does not change the instance parameters, so
# procd leaves running instances alone; HUP makes them reread the files.
reload_service() {
	start
	procd_send_signal rt2wg '*' HUP
}

service_triggers() {
	local s
	procd_add_reload_trigger rt2wg network
	load_instances
	for s in $INSTANCES; do
		procd_add_reload_interface_trigger "$(uci_get rt2wg "$s" interface "$s")"
	done
}
