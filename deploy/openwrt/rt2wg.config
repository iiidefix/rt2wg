# Package to reinstall when sysupgrade has dropped rt2wg, and to install on
# "/etc/init.d/rt2wg upgrade": the apk built for this router's arch.
config package 'package'
	option url ''

# One section per WireGuard interface. The section name is the interface
# unless 'interface' is set.
config instance 'wg0'
	option enabled '0'
	# option interface 'wg0'
	# Routing tables in rank order: names, ids, or all (default: main).
	# list tables 'main'
	# list tables 'all'
	# option log_level 'debug'
