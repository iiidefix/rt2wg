# One section per WireGuard interface. The section name is the interface
# unless 'interface' is set.
config instance 'wg0'
	option enabled '0'
	# option interface 'wg0'
	# Routing tables in rank order: names, ids, or all (default: main).
	# list tables 'main'
	# list tables 'all'
	# option log_level 'debug'
